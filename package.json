{
  "name": "saarathi",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source stream tools for a fitness streamer on YouTube: chat-driven challenge wheel, overlays, phone stream deck, and more.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,overlays -c cyan,magenta \"pnpm --filter @saarathi/server dev\" \"pnpm --filter @saarathi/overlays dev\"",
    "build": "pnpm --filter @saarathi/overlays build",
    "start": "pnpm --filter @saarathi/server start",
    "release:patch": "pnpm version patch -m \"chore(release): v%s\"",
    "release:minor": "pnpm version minor -m \"chore(release): v%s\"",
    "release:major": "pnpm version major -m \"chore(release): v%s\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:fast": "vitest run --project unit --project unit-overlays --project unit-desktop --project integration",
    "test:unit": "vitest run --project unit --project unit-overlays --project unit-desktop",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit --project unit-overlays --project unit-desktop --project integration",
    "test:browser": "pnpm --filter @saarathi/overlays test:browser",
    "dist": "pnpm --filter @saarathi/overlays build && pnpm --filter @saarathi/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  }
}
