{
  "name": "@saarathi/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && electron dist/main.cjs",
    "dist": "node build.mjs && electron-builder --config electron-builder.config.mjs --win --publish never",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "dist:local": "node build.mjs && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "devDependencies": {
    "@saarathi/server": "workspace:*",
    "@saarathi/shared": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3"
  }
}
